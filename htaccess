# =============================================================
# GRUPO PROST — .htaccess de produção
# Apache 2.4+ | mod_rewrite, mod_headers, mod_deflate, mod_expires
# =============================================================

# -------- Segurança básica --------
ServerSignature Off
Options -Indexes -MultiViews

# Bloqueia acesso a arquivos sensíveis
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|docx|md)$)">
    Require all denied
</FilesMatch>

# =============================================================
# 1. REDIRECIONAMENTOS — HTTPS + apex (sem www)
# =============================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Força HTTPS
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http
    RewriteRule ^ https://grupoprost.com.br%{REQUEST_URI} [L,R=301,NE]

    # Remove www
    RewriteCond %{HTTP_HOST} ^www\.grupoprost\.com\.br$ [NC]
    RewriteRule ^ https://grupoprost.com.br%{REQUEST_URI} [L,R=301,NE]

    # URLs limpas: /blindagem -> /blindagem.html
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]

    # Aliases para URLs do sitemap (mecanica/*)
    RewriteRule ^mecanica/motor/?$       motor.html       [L]
    RewriteRule ^mecanica/cambio/?$      cambio.html      [L]
    RewriteRule ^mecanica/freios/?$      freios.html      [L]
    RewriteRule ^mecanica/suspensao/?$   suspensao.html   [L]
    RewriteRule ^mecanica/escapamento/?$ escapamento.html [L]
</IfModule>

# =============================================================
# 2. HEADERS DE SEGURANÇA
# =============================================================
<IfModule mod_headers.c>
    # HSTS — 2 anos, inclui subdomínios, pronto para preload
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

    # Anti-clickjacking / sniffing
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"

    # CSP — ajustada para FontAwesome + Google Fonts + Google Maps + WhatsApp + Instagram
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; connect-src 'self' https://www.google-analytics.com; frame-src https://www.google.com https://www.youtube.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https://api.whatsapp.com; upgrade-insecure-requests; block-all-mixed-content"

    # Remove fingerprinting
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Cross-Origin policies
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-site"
</IfModule>

# =============================================================
# 3. COMPRESSÃO
# =============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/rss+xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# =============================================================
# 4. CACHE DE NAVEGADOR
# =============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                              "access plus 1 month"

    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType text/css                      "access plus 1 month"
    ExpiresByType application/javascript        "access plus 1 month"
    ExpiresByType application/json              "access plus 0 seconds"

    ExpiresByType image/jpg                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType image/x-icon                  "access plus 1 year"

    ExpiresByType font/woff                     "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType application/font-woff2        "access plus 1 year"

    ExpiresByType application/xml               "access plus 1 hour"
    ExpiresByType text/xml                      "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(woff|woff2|ttf|otf)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# =============================================================
# 5. PÁGINAS DE ERRO
# =============================================================
ErrorDocument 404 /index.html

# Charset padrão
AddDefaultCharset UTF-8
